+/** Read the current plain settings section from live Config references. */
+export function readAtFileSettings(config: AtFileSettingsConfig): AtFileSettings {
+  return {
+    enabled: config.enabled.get(),
+    ignoreFiles: [...config.ignoreFiles.get()],
+    ignoreFilesConfigured: config.ignoreFilesConfigured.get(),
+    workspaceIgnoreFiles: config.workspaceIgnoreFiles.get().map(entry => ({
+      workspace: entry.workspace,
+      ignoreFiles: [...entry.ignoreFiles],
+    })),
+    ignorePastedMentions: config.ignorePastedMentions.get(),
+  }
+}
+
+/** Persist one settings field through the owning profile entry. */
+export async function updateAtFileSettings(
+  ctx: Context,
+  config: AtFileSettingsConfig,
+  update: AtFileSettingsUpdate,
+): Promise<AtFileSettings> {
+  const entry = ctx.fiber.entry?.id
+  const settings = ctx.get('settings')
+  if (settings === undefined || entry === undefined) {
+    throw new Error('at-file settings require the Settings service and a profile entry')
+  }
+  const patch = update.field === 'enabled'
+    ? { enabled: update.value }
+    : update.field === 'ignoreFiles'
+      ? { ignoreFiles: normalizeIgnoreFiles(update.value), ignoreFilesConfigured: true }
+      : update.field === 'workspaceIgnoreFiles'
+        ? { workspaceIgnoreFiles: normalizeWorkspaceIgnoreFiles(update.value) }
+        : { ignorePastedMentions: update.value }
+  await settings.update(entry, patch)
+  return readAtFileSettings(config)
 }
