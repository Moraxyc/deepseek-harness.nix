 const delay = (ms: number) => new Promise(resolve => setTimeout(resolve, ms))
 
+// The sandbox builds every bundle at once, so a single sleep races the render:
+// the settles below wait for the state the assertions read, while every
+// original delay stays in place to keep the probe's input pacing.
+const settle = async (predicate: () => boolean, timeoutMs = 20000) => {
+  const deadline = Date.now() + timeoutMs
+  while (!predicate() && Date.now() < deadline) await delay(10)
+}
