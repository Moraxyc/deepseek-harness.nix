diff --git a/apps/desktop/src/nix-profile.ts b/apps/desktop/src/nix-profile.ts
--- /dev/null
+++ b/apps/desktop/src/nix-profile.ts
@@ -0,0 +1,20 @@
+import { execFileSync } from 'node:child_process'
+import { readFileSync } from 'node:fs'
+
+interface NixProfile {
+  home: string | null
+  profile: string
+  seeder: string
+  mode: 'managed' | 'mutable'
+}
+
+export function initializeNixProfile(): void {
+  const config = JSON.parse(readFileSync(new URL('../nix-profile.json', import.meta.url), 'utf8')) as NixProfile | null
+  delete process.env.DSH_NIX_DESKTOP_PROFILE
+  delete process.env.DSH_NIX_DESKTOP_PROFILE_MODE
+  if (config === null) return
+  if (config.home !== null) process.env.DSH_HOME = config.home
+  process.env.DSH_NIX_DESKTOP_PROFILE = config.profile
+  process.env.DSH_NIX_DESKTOP_PROFILE_MODE = config.mode
+  execFileSync(config.seeder, [config.profile], { stdio: 'inherit', timeout: 60_000 })
+}
