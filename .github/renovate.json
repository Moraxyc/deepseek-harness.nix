{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["github-actions", "npm"],
  "includePaths": [
    ".github/workflows/**",
    "docs-site/**",
    "modules/flake-parts/dev/checks/fixtures/bundle-helper-npm/**"
  ],
  "packageRules": [
    {
      "description": "Automerge non-major dependency updates after Merge Check",
      "matchManagers": ["github-actions", "npm"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
