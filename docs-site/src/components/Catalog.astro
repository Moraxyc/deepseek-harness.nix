---
import { catalog } from '../data/catalog';

interface Props {
  locale: 'en' | 'zh-CN';
}

const { locale } = Astro.props;
const isChinese = locale === 'zh-CN';
const text = isChinese
  ? {
      bundles: 'Bundles',
      presets: '预设',
      flakeOutput: 'Flake 输出',
      package: '包',
      version: '版本',
      description: '说明',
      homepage: '主页',
      defaultProfile: '默认 profile',
      bundlesColumn: 'Bundles',
      unavailable: '暂无',
    }
  : {
      bundles: 'Bundles',
      presets: 'Presets',
      flakeOutput: 'Flake output',
      package: 'Package',
      version: 'Version',
      description: 'Description',
      homepage: 'Homepage',
      defaultProfile: 'Default profile',
      bundlesColumn: 'Bundles',
      unavailable: 'Not available',
    };

const descriptionFor = (item: { description: string | null; descriptionZh: string | null }) =>
  (isChinese ? item.descriptionZh : item.description) ?? text.unavailable;

const valueFor = (value: string | null) => value ?? text.unavailable;
---

<section class="catalog-section" aria-labelledby="bundles-heading">
  <h2 id="bundles-heading">{text.bundles}</h2>
  <div class="catalog-table-wrap">
    <table class="catalog-table">
      <thead>
        <tr>
          <th scope="col">{text.flakeOutput}</th>
          <th scope="col">{text.package}</th>
          <th scope="col">{text.version}</th>
          <th scope="col">{text.description}</th>
          <th scope="col">{text.homepage}</th>
        </tr>
      </thead>
      <tbody>
        {catalog.bundles.map((bundle) => (
          <tr>
            <td><code>bundles.{bundle.name}</code></td>
            <td><code>{bundle.package}</code></td>
            <td>{valueFor(bundle.version)}</td>
            <td>{descriptionFor(bundle)}</td>
            <td>
              {bundle.homepage ? <a href={bundle.homepage}>{text.homepage}</a> : text.unavailable}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<section class="catalog-section" aria-labelledby="presets-heading">
  <h2 id="presets-heading">{text.presets}</h2>
  <div class="catalog-table-wrap">
    <table class="catalog-table">
      <thead>
        <tr>
          <th scope="col">{text.flakeOutput}</th>
          <th scope="col">{text.defaultProfile}</th>
          <th scope="col">{text.bundlesColumn}</th>
          <th scope="col">{text.description}</th>
          <th scope="col">{text.homepage}</th>
        </tr>
      </thead>
      <tbody>
        {catalog.presets.map((preset) => (
          <tr>
            <td><code>presets.{preset.name}</code></td>
            <td>{preset.defaultProfile ? <code>{preset.defaultProfile}</code> : text.unavailable}</td>
            <td>
              {preset.bundles.length > 0 ? (
                <ul class="catalog-values">
                  {preset.bundles.map((bundle) => <li><code>{bundle}</code></li>)}
                </ul>
              ) : text.unavailable}
            </td>
            <td>{descriptionFor(preset)}</td>
            <td>
              {preset.homepage ? <a href={preset.homepage}>{text.homepage}</a> : text.unavailable}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
